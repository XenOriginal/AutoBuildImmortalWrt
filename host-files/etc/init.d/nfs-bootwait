#!/bin/sh /etc/rc.common
# /etc/init.d/nfs-bootwait
#   S99: 在 dockerd 之后启动的后台补齐进程。
#
# 为什么需要它:
#   NAS 通常比路由器晚 3~5 分钟才上线（DHCP 租约可见）。原来只能靠 cron 的
#   watch 每 2 分钟重试，命中时机靠运气 —— 实测有一次开机后 2 分 47 秒才把容器
#   拉起来。bootwait 用 8 秒周期探测，NAS 一上线就挂载 + 起容器并退出。
#
# 用 procd 托管而不是 `&` 后台派发：procd 会跟踪它，重启/关机时能干净退出，
# 也不会被 init 脚本退出时连带清理。
START=99
USE_PROCD=1

start_service() {
	[ -x /usr/local/bin/nfs-guard ] || return 0
	procd_open_instance bootwait
	procd_set_param command /usr/local/bin/nfs-guard bootwait
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	: # 退出由 nfs-guard bootwait 自己观察 /tmp/.nfs-guard-stop 完成
}
