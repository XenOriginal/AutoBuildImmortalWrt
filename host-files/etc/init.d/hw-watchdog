#!/bin/sh /etc/rc.common
# ============================================================================
# 硬件看门狗喂狗服务 (iTCO_wdt / Denverton)
#
# 【行为】
#   1. 等 A/B 的 boot_ok=1 (最多 5 分钟) —— 新槽若起不来, 不 arm 看门狗,
#      让 GRUB 的失败回滚判定正常进行, 不被看门狗反复重启掩盖。
#   2. 打开 /dev/watchdog (打开即开始计时), 之后每 5 秒喂一次。
#   3. 收到 TERM/INT 时写入魔数 'V' 并退出(驱动在关闭时解除武装)。
#      注意: kill -9 会跳过魔数关闭, 硬件超时后机器会重启 —— 这是看门狗的
#      设计语义, 不是缺陷。
#
# 【可调】
#   AB_WATCHDOG_WAIT : 等 boot_ok 的最长秒数 (默认 300)
#   AB_WATCHDOG_PET  : 喂狗间隔秒数 (默认 5; 必须明显小于硬件超时)
#
# 【为什么间隔是 5 秒】内核 watchdog_thresh 默认 10s, iTCO 常用 2x 阈值,
#   即约 20s。5 秒喂一次留足余量。
# ============================================================================

START=96
STOP=4

DEV=/dev/watchdog
LOG=/etc/hw-watchdog.log

log() { logger -t hw-watchdog "$1"; echo "$(date '+%F %T') $1" >> "$LOG"; }

wait_boot_ok() {
    local e n=0 wait=${AB_WATCHDOG_WAIT:-300}
    [ -f /usr/lib/ab-lib.sh ] && . /usr/lib/ab-lib.sh
    while [ "$n" -lt "$wait" ]; do
        if command -v ab_env_path >/dev/null 2>&1; then
            e=$(ab_env_path 2>/dev/null) || { sleep 10; n=$((n + 10)); continue; }
            [ "$(grub-editenv "$e" list 2>/dev/null | sed -n 's/^boot_ok=//p')" = "1" ] && return 0
        else
            return 0   # 非 A/B 布局: 无需等待
        fi
        sleep 10
        n=$((n + 10))
    done
    return 1
}

start() {
    [ -e "$DEV" ] || { log "无 $DEV (kmod-itco-wdt 未加载?), 跳过"; return 0; }
    ( tail -f /dev/null & echo $! > /var/run/hw-watchdog.lock ) 2>/dev/null

    (
        if ! wait_boot_ok; then
            log "等待 boot_ok 超时 —— 不 arm 看门狗 (避免掩盖 A/B 回滚判定)"
            exit 0
        fi
        [ -e "$DEV" ] || exit 0

        # Prefer a 60 s hardware timeout: the normal poweroff path is ~16-20 s,
        # but a slow reboot must not be cut off by a 20 s watchdog.
        if [ -w /sys/class/watchdog/watchdog0/timeout ]; then
            echo 60 > /sys/class/watchdog/watchdog0/timeout 2>/dev/null || true
        fi
        exec 9>"$DEV" || { log "打开 $DEV 失败"; exit 1; }
        log "watchdog armed (间隔 ${AB_WATCHDOG_PET:-5}s, 超时 $(cat /sys/class/watchdog/watchdog0/timeout 2>/dev/null)s)"

        trap 'printf "V" >&9 2>/dev/null; log "watchdog disarmed (魔数关闭)"; exit 0' TERM INT
        while :; do
            printf '\0' >&9 2>/dev/null || { log "喂狗写失败, 退出"; exit 1; }
            sleep "${AB_WATCHDOG_PET:-5}"
        done
    ) &
    echo $! > /var/run/hw-watchdog.pid
}

stop() {
    [ -f /var/run/hw-watchdog.pid ] && kill "$(cat /var/run/hw-watchdog.pid)" 2>/dev/null
    sleep 1
    # 兜底: 若喂狗进程没来得及魔数关闭, 这里再关一次
    [ -e "$DEV" ] && printf 'V' > "$DEV" 2>/dev/null
    log "watchdog stopped"
}
